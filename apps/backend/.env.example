# Database (pick one target; both need pgvector for AI features)
# Docker Compose (recommended): docker compose up db -d
DATABASE_URL="postgresql://postgres:password@localhost:5433/unilearn?schema=public"
# Native Postgres on port 5432 (install pgvector extension; use migrate deploy, not migrate dev)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/unilearn?schema=public"

# Auth (required)
ACCESS_TOKEN_SECRET="change-me-access"
REFRESH_TOKEN_SECRET="change-me-refresh"

# Browser origin(s) for CORS + credentials (comma-separated). Match your Vite dev URL.
CLIENT_ORIGIN="http://localhost:5173"

# Cookie flag: in production cookies use Secure when NODE_ENV=production unless COOKIE_SECURE=false.
# Set COOKIE_SECURE=true to force Secure cookies (HTTPS only).

# Cloudinary (required for instructor file uploads)
# Option A: single connection URL from the Cloudinary dashboard
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option B: individual values
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Optional: enable Aspose Office→PDF conversion (requires paid Cloudinary add-on).
# When false/unset, PPT/DOC files upload to Cloudinary as originals (students download them).
# CLOUDINARY_ASPOSE_ENABLED=false
# Dashboard → Settings → Security → enable "Allow delivery of PDF and ZIP files"
# if PowerPoint/Word in-app PDF previews fail (401). Native PDF uploads use raw delivery.

# Public backend URL for Cloudinary conversion webhooks (use ngrok in local dev)
# PUBLIC_API_URL=http://localhost:4000

# AI service (optional — required for RAG indexing after upload)
# AI_SERVICE_URL=http://127.0.0.1:8000
# AI_INTERNAL_API_KEY=change-me-in-development
