generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(uuid())
  username           String?            @unique
  email              String             @unique
  role               Role
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  name               String
  password           String
  mustChangePassword Boolean            @default(false)
  instructorProfile  InstructorProfile?
  quizes             Quiz[]
  refreshTokens      RefreshToken[]
  resources          Resource[]
  studentProfile     StudentProfile?

  @@index([email])
}

model StudentProfile {
  id           String        @id
  studnetId    String        @unique
  acadamicYear Int
  departmentId String
  progress     Progress[]
  quizzes      Quiz[]
  attempts     QuizAttempt[]
  department   Department    @relation(fields: [departmentId], references: [id])
  student      User          @relation(fields: [id], references: [id], onDelete: Cascade)
  summaries    Summary[]
  chatThreads  ChatThread[]
}

model InstructorProfile {
  id           String     @id
  instructorId String     @unique
  departmentId String
  courses      Course[]
  department   Department @relation(fields: [departmentId], references: [id])
  instructor   User       @relation(fields: [id], references: [id], onDelete: Cascade)
  resources    Resource[]
}

model Department {
  id         String              @id @default(uuid())
  name       String
  code       String              @unique
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  courses    Course[]
  instructor InstructorProfile[]
  students   StudentProfile[]
}

model Course {
  id           String             @id @default(uuid())
  name         String
  code         String             @unique
  acadamicYear Int
  departmentId String
  instructorId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  department   Department         @relation(fields: [departmentId], references: [id])
  instructor   InstructorProfile? @relation(fields: [instructorId], references: [id])
  progress     Progress[]
  resources    Resource[]

  @@index([instructorId])
}

model Resource {
  id                  String             @id @default(uuid())
  title               String
  type                FileType
  fileUrl             String             @unique
  courseId            String
  instructorId        String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  instructorProfileId String?
  isDeleted           Boolean            @default(false)
  version             Float
  status              ResourceStatus     @default(QUEUED)
  cloudinaryPublicId  String?            @unique
  quiz                Quiz[]
  course              Course             @relation(fields: [courseId], references: [id])
  instructor          User               @relation(fields: [instructorId], references: [id])
  instructorProfile   InstructorProfile? @relation(fields: [instructorProfileId], references: [id])
  chunks              ResourceChunk[]
  summaries           Summary[]
  chatThreads         ChatThread[]

  @@index([courseId])
  @@index([instructorId])
}

model ResourceChunk {
  id         String   @id @default(uuid())
  resourceId String
  chunkIndex Int
  pageNumber Int
  content    String
  tokenCount Int
  embedding  Float[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, chunkIndex])
  @@index([resourceId])
}

model Summary {
  id         String         @id @default(uuid())
  content    String
  resourceId String
  studnetId  String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  resource   Resource       @relation(fields: [resourceId], references: [id])
  student    StudentProfile @relation(fields: [studnetId], references: [id])

  @@index([resourceId])
  @@index([studnetId])
}

model ChatThread {
  id         String        @id @default(uuid())
  resourceId String
  studnetId  String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studnetId], references: [id])
  messages   ChatMessage[]

  @@unique([resourceId, studnetId])
  @@index([resourceId])
  @@index([studnetId])
}

model ChatMessage {
  id        String          @id @default(uuid())
  threadId  String
  role      ChatMessageRole
  content   String
  citations Json?
  createdAt DateTime        @default(now())
  thread    ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model Quiz {
  id         String         @id @default(uuid())
  difficulty Difficulty
  title      String
  resourceId String
  studnetId  String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  userId     String?
  questions  Question[]
  resource   Resource       @relation(fields: [resourceId], references: [id])
  student    StudentProfile @relation(fields: [studnetId], references: [id])
  user       User?          @relation(fields: [userId], references: [id])
  attempts   QuizAttempt[]

  @@index([resourceId])
}

model Question {
  id         String   @id @default(uuid())
  content    String
  options    Json?
  correctAns String
  quizId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  quiz       Quiz     @relation(fields: [quizId], references: [id])

  @@index([quizId])
}

model QuizAttempt {
  id        String         @id @default(uuid())
  score     Int
  results   Json?
  quizId    String
  studnetId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  quiz      Quiz           @relation(fields: [quizId], references: [id])
  student   StudentProfile @relation(fields: [studnetId], references: [id])

  @@index([quizId])
  @@index([studnetId])
}

model Progress {
  id             String         @id @default(uuid())
  resourceViewed Int
  averageScore   Float
  studnetId      String
  courseId       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  course         Course         @relation(fields: [courseId], references: [id])
  student        StudentProfile @relation(fields: [studnetId], references: [id])

  @@unique([studnetId, courseId])
  @@index([studnetId])
  @@index([courseId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiredAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum FileType {
  PDF
  PPT
  DOC
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ResourceStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}
