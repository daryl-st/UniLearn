# Origins allowed to call this API from a browser (comma-separated).
# Default in code is http://localhost:4000 if unset.
CORS_ORIGINS=http://localhost:4000

# Must match the Node backend AI_INTERNAL_API_KEY (required for /extract/*).
AI_INTERNAL_API_KEY=change-me-in-development

# Comma-separated hostnames allowed for POST /extract/url (SSRF guard). Leave empty to disable URL mode.
# EXTRACT_URL_ALLOWED_HOSTS=res.cloudinary.com,example.com
