# Origins allowed to call this API from a browser (comma-separated).
# Default in code is http://localhost:4000 if unset.
CORS_ORIGINS=http://localhost:4000

# Must match the Node backend AI_INTERNAL_API_KEY (required for /extract/*).
AI_INTERNAL_API_KEY=change-me-in-development

# Comma-separated hostnames allowed for POST /extract/url and POST /ingest/resource (SSRF guard).
# Leave empty to disable URL download. Include your Cloudinary host for production ingest.
EXTRACT_URL_ALLOWED_HOSTS=res.cloudinary.com

# Semantic chunking (POST /ingest/resource)
# CHUNK_MAX_TOKENS=512
# CHUNK_MIN_TOKENS=50
# CHUNK_TOKEN_ENCODING=cl100k_base

# Gemini (free tier) for embeddings + grounded answer generation.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMENSIONS=768
# GEMINI_EMBED_TIMEOUT_SEC=60
# GEMINI_GEN_MODEL=gemini-2.5-flash
# GEMINI_GEN_FALLBACK_MODELS=gemini-2.5-flash-lite
# GEMINI_GEN_MAX_RETRIES=3
# RAG_MAX_CONTEXT_CHUNKS=5

# Database URL for retrieval over pgvector (`POST /rag/ask`).
# Must match apps/backend — same DB, same port.
# Docker Compose db service (host): localhost:5433
# Native Postgres on host: localhost:5432
# DATABASE_URL=postgresql://postgres:password@localhost:5432/unilearn
